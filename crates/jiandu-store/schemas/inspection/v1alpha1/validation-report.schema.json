{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationReport",
  "description": "Strict canonical validation report. Invalid stores can omit identity and\nwatermark while still returning closed safe findings.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "description": "Validation report format identifier.",
      "type": "string",
      "minLength": 33,
      "maxLength": 33,
      "pattern": "^jiandu\\.validation-report/v1alpha1$"
    },
    "mode": {
      "description": "Scope visibility mode used by this inspection.",
      "$ref": "#/$defs/ValidationMode"
    },
    "sourceStoreId": {
      "description": "Opaque source identity, omitted when metadata is not authoritative.",
      "anyOf": [
        {
          "$ref": "#/$defs/StoreId"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot": {
      "description": "Snapshot watermark, omitted together with source identity.",
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotWatermark"
        },
        {
          "type": "null"
        }
      ]
    },
    "inspectedScopes": {
      "description": "Canonically sorted scopes inspected or discovered.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemoryScope"
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "findings": {
      "description": "Canonically sorted, deduplicated safe findings.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationFinding"
      },
      "maxItems": 257,
      "uniqueItems": true
    },
    "truncated": {
      "description": "Whether a bounded scan stopped before visiting the whole selection.",
      "type": "boolean"
    },
    "digest": {
      "description": "Domain-separated digest of every preceding report field.",
      "$ref": "#/$defs/ExportDigest"
    }
  },
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "mode",
    "inspectedScopes",
    "findings",
    "truncated",
    "digest"
  ],
  "$defs": {
    "ValidationMode": {
      "description": "Whether validation was limited to explicit scopes or covered the store.",
      "type": "string",
      "enum": [
        "scoped",
        "all_scopes"
      ]
    },
    "StoreId": {
      "description": "Opaque UUID-backed store identity.",
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "SnapshotWatermark": {
      "description": "Stable metadata watermark captured under one read-only coordinated snapshot.",
      "type": "object",
      "properties": {
        "storeRevision": {
          "description": "Canonical store revision at the coordinated snapshot.",
          "$ref": "#/$defs/StoreRevision"
        },
        "auditSequence": {
          "description": "Independent private-audit sequence at the same snapshot.",
          "$ref": "#/$defs/AuditSequence"
        }
      },
      "additionalProperties": false,
      "required": [
        "storeRevision",
        "auditSequence"
      ]
    },
    "StoreRevision": {
      "description": "Monotonic revision of the canonical store; zero represents an empty store.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "AuditSequence": {
      "description": "Independent monotonic address of the private mutation audit ledger.\n\nZero is the genesis watermark. Each committed create/update advances this\nvalue exactly once; idempotent replay never advances it.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "MemoryScope": {
      "description": "Authoritative scope stamped onto a resolved memory record.\n\nUnlike a request selector, a Principal record carries the trusted owner ID\nselected by policy. Project and Session membership remain authorization\ndata outside this value.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "principalId": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "principalId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            },
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "projectId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/SessionId"
            },
            "kind": {
              "type": "string",
              "const": "session"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sessionId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "instance_global"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^prn_[A-Za-z0-9_-]+$"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    },
    "SessionId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^ses_[A-Za-z0-9_-]+$"
    },
    "ValidationFinding": {
      "description": "One path/body/credential/key/query-free validation finding.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Closed machine-readable finding category.",
          "$ref": "#/$defs/ValidationCode"
        },
        "artifact": {
          "description": "Logical artifact class affected by the finding.",
          "$ref": "#/$defs/ValidationArtifact"
        },
        "scope": {
          "description": "Authorized or admin-visible logical scope when safely known.",
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryId": {
          "description": "Opaque memory identity only when safely bound and authorized.",
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "artifact"
      ]
    },
    "ValidationCode": {
      "description": "Closed, stable and secret-safe validation categories.",
      "type": "string",
      "enum": [
        "store_metadata_inconsistent",
        "unsupported_store_version",
        "layout_inconsistent",
        "unsafe_entry",
        "active_transaction",
        "record_malformed",
        "record_id_mismatch",
        "scope_path_mismatch",
        "shard_mismatch",
        "duplicate_memory_id",
        "record_tombstone_conflict",
        "tombstone_inconsistent",
        "receipt_inconsistent",
        "result_inconsistent",
        "audit_inconsistent",
        "witness_inconsistent",
        "snapshot_changed",
        "scan_limit_exceeded",
        "finding_limit_reached"
      ]
    },
    "ValidationArtifact": {
      "description": "Stable logical artifact category; never a canonical or ambient path.",
      "type": "string",
      "enum": [
        "store_metadata",
        "layout",
        "transaction",
        "record",
        "tombstone",
        "receipt",
        "result",
        "audit",
        "witness",
        "snapshot"
      ]
    },
    "MemoryId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^mem_[A-Za-z0-9_-]+$"
    },
    "ExportDigest": {
      "description": "Domain-separated SHA-256 digest of a canonical report or bundle payload.",
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
