{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportDryRunPlan",
  "description": "Strict deterministic zero-write import dry run.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "minLength": 27,
      "maxLength": 27,
      "pattern": "^jiandu\\.import-plan/v1alpha1$"
    },
    "sourceStoreId": {
      "$ref": "#/$defs/StoreId"
    },
    "bundleDigest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "targetStoreId": {
      "$ref": "#/$defs/StoreId"
    },
    "targetSnapshot": {
      "$ref": "#/$defs/SnapshotWatermark"
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportScopeDecision"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportPlanEntry"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "counts": {
      "$ref": "#/$defs/ImportPlanCounts"
    },
    "committable": {
      "type": "boolean"
    },
    "digest": {
      "$ref": "#/$defs/ImportDigest"
    }
  },
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "sourceStoreId",
    "bundleDigest",
    "targetStoreId",
    "targetSnapshot",
    "scopes",
    "entries",
    "counts",
    "committable",
    "digest"
  ],
  "$defs": {
    "StoreId": {
      "description": "Opaque UUID-backed store identity.",
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "SnapshotWatermark": {
      "description": "Stable metadata watermark captured under one read-only coordinated snapshot.",
      "type": "object",
      "properties": {
        "storeRevision": {
          "description": "Canonical store revision at the coordinated snapshot.",
          "$ref": "#/$defs/StoreRevision"
        },
        "auditSequence": {
          "description": "Independent private-audit sequence at the same snapshot.",
          "$ref": "#/$defs/AuditSequence"
        }
      },
      "additionalProperties": false,
      "required": [
        "storeRevision",
        "auditSequence"
      ]
    },
    "StoreRevision": {
      "description": "Monotonic revision of the canonical store; zero represents an empty store.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "AuditSequence": {
      "description": "Independent monotonic address of the private mutation audit ledger.\n\nZero is the genesis watermark. Each committed audited mutation or portable\nimport advances this value exactly once; idempotent replay never advances\nit.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "ImportScopeDecision": {
      "description": "Fresh per-scope authority decision included in the dry run.",
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "authorized": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "authorized"
      ]
    },
    "MemoryScope": {
      "description": "Authoritative scope stamped onto a resolved memory record.\n\nUnlike a request selector, a Principal record carries the trusted owner ID\nselected by policy. Project and Session membership remain authorization\ndata outside this value.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "principalId": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "principalId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            },
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "projectId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/SessionId"
            },
            "kind": {
              "type": "string",
              "const": "session"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sessionId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "instance_global"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PrincipalId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^prn_[A-Za-z0-9_-]+$"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    },
    "SessionId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^ses_[A-Za-z0-9_-]+$"
    },
    "ImportPlanEntry": {
      "description": "Body-free plan entry for one opaque portable record or tombstone.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ImportItemKind"
        },
        "memoryId": {
          "$ref": "#/$defs/MemoryId"
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "classification": {
          "$ref": "#/$defs/ImportClassification"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "memoryId",
        "scope",
        "classification"
      ]
    },
    "ImportItemKind": {
      "description": "Portable entry kind classified by a dry run.",
      "type": "string",
      "enum": [
        "record",
        "tombstone"
      ]
    },
    "MemoryId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^mem_[A-Za-z0-9_-]+$"
    },
    "ImportClassification": {
      "description": "Closed deterministic import classification.",
      "type": "string",
      "enum": [
        "accepted",
        "conflicting",
        "unauthorized",
        "tombstone_protected",
        "invalid"
      ]
    },
    "ImportPlanCounts": {
      "description": "Exact category totals committed into the plan digest.",
      "type": "object",
      "properties": {
        "accepted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "conflicting": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unauthorized": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tombstoneProtected": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "accepted",
        "conflicting",
        "unauthorized",
        "tombstoneProtected",
        "invalid"
      ]
    },
    "ImportDigest": {
      "description": "Domain-separated lowercase SHA-256 digest used by import contracts.",
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
