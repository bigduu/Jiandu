{
  "fixtureVersion": "jiandu.service/conformance/v1alpha1",
  "protocolVersion": "2025-11-25",
  "apiVersion": "jiandu.dev/v1alpha1",
  "harnessVersion": "0.1.0",
  "drivers": {
    "official": { "package": "rmcp", "version": "3.1.4" },
    "rawHttp": { "package": "reqwest", "version": "0.13.4" }
  },
  "tools": [
    { "name": "memory_forget", "inputSchema": "crates/jiandu-core/schemas/v1alpha1/forget-memory-command.schema.json" },
    { "name": "memory_get", "inputSchema": "crates/jiandu-core/schemas/v1alpha1/memory-get-request.schema.json" },
    { "name": "memory_list", "inputSchema": "crates/jiandu-core/schemas/v1alpha1/memory-list-request.schema.json" },
    { "name": "memory_remember", "inputSchema": "crates/jiandu-core/schemas/v1alpha1/remember-memory-command.schema.json" },
    { "name": "memory_search", "inputSchema": "crates/jiandu-core/schemas/v1alpha1/memory-search-request.schema.json" },
    { "name": "memory_update", "inputSchema": "crates/jiandu-core/schemas/v1alpha1/update-memory-command.schema.json" }
  ],
  "resources": ["jiandu://scope/principal/memories"],
  "resourceTemplates": [
    "jiandu://memory/{memoryId}",
    "jiandu://scope/project/{projectId}/memories",
    "jiandu://scope/session/{sessionId}/memories",
    "jiandu://scope/instance_global/memories"
  ],
  "domainErrors": [
    "INVALID_ARGUMENT",
    "NOT_FOUND",
    "REVISION_CONFLICT",
    "IDEMPOTENCY_CONFLICT",
    "FORBIDDEN"
  ],
  "unauthorized": {
    "status": 401,
    "body": "{\"error\":\"unauthorized\"}",
    "cacheControl": "no-store",
    "challenge": "Bearer"
  }
}
