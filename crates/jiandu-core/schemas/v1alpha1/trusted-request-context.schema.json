{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrustedRequestContext",
  "description": "Authenticated identity supplied by a trusted transport adapter.\n\nThis type is deliberately separate from every model-visible command. A\ncaller must pass it beside a command after authentication; no command can\nselect a principal or impersonate a client.",
  "type": "object",
  "properties": {
    "principalId": {
      "$ref": "#/$defs/PrincipalId"
    },
    "clientId": {
      "$ref": "#/$defs/ClientId"
    },
    "grants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Grant"
      },
      "maxItems": 64
    }
  },
  "additionalProperties": false,
  "required": [
    "principalId",
    "clientId",
    "grants"
  ],
  "$defs": {
    "PrincipalId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^prn_[A-Za-z0-9_-]+$"
    },
    "ClientId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^cli_[A-Za-z0-9_-]+$"
    },
    "Grant": {
      "description": "An authorization capability established by the host authentication boundary.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9:_-]*$"
    }
  }
}
