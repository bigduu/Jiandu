{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryGetRequest",
  "description": "Read exactly one visible record by opaque ID.",
  "type": "object",
  "properties": {
    "memoryId": {
      "$ref": "#/$defs/MemoryId"
    }
  },
  "additionalProperties": false,
  "required": [
    "memoryId"
  ],
  "$defs": {
    "MemoryId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^mem_[A-Za-z0-9_-]+$"
    }
  }
}
