{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RememberMemoryCommand",
  "description": "Create one memory in an authorized scope.",
  "type": "object",
  "properties": {
    "scope": {
      "$ref": "#/$defs/ScopeSelector"
    },
    "type": {
      "$ref": "#/$defs/MemoryType"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1000
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "x-jiandu-maxUtf8Bytes": 65536
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tag"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceInput"
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemoryRelation"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "idempotencyKey": {
      "$ref": "#/$defs/IdempotencyKey"
    }
  },
  "additionalProperties": false,
  "required": [
    "scope",
    "type",
    "title",
    "body",
    "provenance",
    "idempotencyKey"
  ],
  "$defs": {
    "ScopeSelector": {
      "description": "Model-visible scope selector.\n\nPrincipal identity is intentionally absent: the authenticated principal is\nalways taken from [`crate::TrustedRequestContext`]. Project and Session IDs\nare opaque host-resolved identities, never paths.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "principal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            },
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "projectId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/SessionId"
            },
            "kind": {
              "type": "string",
              "const": "session"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sessionId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "instance_global"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ProjectId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    },
    "SessionId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^ses_[A-Za-z0-9_-]+$"
    },
    "MemoryType": {
      "description": "Closed memory categories for the v1alpha1 record schema.",
      "type": "string",
      "enum": [
        "preference",
        "decision",
        "project",
        "fact",
        "feedback",
        "reference"
      ]
    },
    "Tag": {
      "description": "Canonical lower-case tag.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "ProvenanceInput": {
      "description": "Caller-supplied portable provenance for a newly remembered record.\n\n`createdBy` is deliberately absent: the service stamps that value from its\ntrusted invocation context when it constructs the authoritative record.",
      "type": "object",
      "properties": {
        "agentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "branchId": {
          "anyOf": [
            {
              "$ref": "#/$defs/BranchId"
            },
            {
              "type": "null"
            }
          ]
        },
        "messageIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessageId"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "messageRange": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommittedMessageRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceUri": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceUri"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "AgentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "BranchId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128,
      "pattern": "^br_[A-Za-z0-9_-]+$"
    },
    "MessageId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^msg_[A-Za-z0-9_-]+$"
    },
    "CommittedMessageRange": {
      "description": "Inclusive range of committed host messages.",
      "type": "object",
      "properties": {
        "firstMessageId": {
          "$ref": "#/$defs/MessageId"
        },
        "lastMessageId": {
          "$ref": "#/$defs/MessageId"
        }
      },
      "additionalProperties": false,
      "required": [
        "firstMessageId",
        "lastMessageId"
      ]
    },
    "SourceUri": {
      "description": "URI identifying external provenance without making a filesystem path an identity.",
      "type": "string",
      "minLength": 3,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[!-~]+$"
    },
    "ContentDigest": {
      "description": "Algorithm-qualified digest such as `sha256:<hex>`.",
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z0-9_]+:[A-Fa-f0-9]+$"
    },
    "ExtractionProvenance": {
      "description": "Optional extraction provenance.",
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/ExtractionMethod"
        },
        "extractorVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false,
      "required": [
        "method"
      ]
    },
    "ExtractionMethod": {
      "description": "How memory content was selected or extracted.",
      "type": "string",
      "enum": [
        "explicit",
        "host_rule",
        "model",
        "import"
      ]
    },
    "Confidence": {
      "type": "number",
      "format": "double",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "MemoryRelation": {
      "description": "One directed relation to another memory.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RelationKind"
        },
        "targetMemoryId": {
          "$ref": "#/$defs/MemoryId"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "targetMemoryId"
      ]
    },
    "RelationKind": {
      "description": "Typed relation between two opaque memory records.",
      "type": "string",
      "enum": [
        "supersedes",
        "supports",
        "contradicts",
        "derived_from",
        "related_to"
      ]
    },
    "MemoryId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^mem_[A-Za-z0-9_-]+$"
    },
    "IdempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  }
}
